const SERVER_NAME = {{SERVER_NAME}};
const SOURCE_URL = {{SOURCE_URL}};
const API_BASE = {{API_BASE}};
const AUTH = {{AUTH_JSON}};
const TOOLS = {{TOOLS_JSON}};
const TOOL_ENDPOINTS = {{TOOL_ENDPOINTS_JSON}};
const MOCK = {{MOCK_JSON}};

const CORS = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Headers": "Content-Type, Authorization",
  "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
};

function json(body, status = 200) {
  return new Response(JSON.stringify(body), {
    status,
    headers: { "Content-Type": "application/json", ...CORS },
  });
}

function applyAuth() {
  const headers = {};
  const queryParams = {};
  const c = AUTH.credentials || {};
  switch (AUTH.type) {
    case "basic": {
      const u = c.username || "";
      const p = c.password || "";
      headers["Authorization"] = "Basic " + btoa(u + ":" + p);
      break;
    }
    case "bearer":
      headers["Authorization"] = "Bearer " + (c.token || "");
      break;
    case "api_key_header": {
      const name = (c.key_name || "").trim() || "X-API-Key";
      headers[name] = c.key_value || "";
      break;
    }
    case "api_key_query": {
      const name = (c.key_name || "").trim() || "api_key";
      queryParams[name] = c.key_value || "";
      break;
    }
    case "none":
    default:
      break;
  }
  return { headers, queryParams };
}

function buildUrl(base, p, queryParams) {
  const b = String(base).replace(/\/+$/, "");
  const path = p.startsWith("/") ? p : "/" + p;
  const url = new URL(b + path);
  for (const k of Object.keys(queryParams || {})) {
    url.searchParams.set(k, queryParams[k]);
  }
  return url;
}

/** Substitute :foo and {foo} placeholders from input, deleting consumed keys. */
function substitutePathParams(p, input) {
  return p.replace(/(?::([a-zA-Z_]\w*))|\{([a-zA-Z_]\w*)\}/g, (_, a, b) => {
    const key = a || b;
    if (input && Object.prototype.hasOwnProperty.call(input, key)) {
      const v = input[key];
      delete input[key];
      return encodeURIComponent(String(v));
    }
    return "";
  });
}

async function callBackend(toolName, input) {
  // Mock takes priority — used for the Akaunting demo so the live demo always
  // returns realistic data, regardless of any API_BASE config.
  if (Object.prototype.hasOwnProperty.call(MOCK, toolName)) {
    return MOCK[toolName];
  }

  const endpoint = TOOL_ENDPOINTS[toolName];
  if (!API_BASE || !endpoint || !endpoint.path) {
    return {
      tool: toolName,
      received_input: input,
      note:
        "This MCP was generated by AutoMCP from " +
        SOURCE_URL +
        ". The tool has no backend endpoint wired — connect a backend in the AutoMCP UI to return live data.",
    };
  }

  const inputCopy = { ...(input || {}) };
  const resolvedPath = substitutePathParams(endpoint.path, inputCopy);
  const { headers: authHeaders, queryParams } = applyAuth();
  const url = buildUrl(API_BASE, resolvedPath, queryParams);
  const method = (endpoint.method || "POST").toUpperCase();

  const reqHeaders = { Accept: "application/json", ...authHeaders };
  let reqBody;

  if (method === "GET" || method === "DELETE" || method === "HEAD") {
    for (const k of Object.keys(inputCopy)) {
      const v = inputCopy[k];
      url.searchParams.set(
        k,
        typeof v === "object" ? JSON.stringify(v) : String(v),
      );
    }
  } else {
    const ct = endpoint.content_type || "application/json";
    reqHeaders["Content-Type"] = ct;
    if (ct === "application/x-www-form-urlencoded") {
      const params = new URLSearchParams();
      for (const k of Object.keys(inputCopy)) {
        const v = inputCopy[k];
        params.set(k, typeof v === "object" ? JSON.stringify(v) : String(v));
      }
      reqBody = params.toString();
    } else {
      reqBody = JSON.stringify(inputCopy);
    }
  }

  const res = await fetch(url.toString(), {
    method,
    headers: reqHeaders,
    body: reqBody,
    redirect: "follow",
  });
  const text = await res.text();
  try {
    return JSON.parse(text);
  } catch {
    return { raw_response: text, status: res.status };
  }
}

async function handleRpc(req) {
  const { method, params, id } = req || {};

  switch (method) {
    case "initialize":
      return {
        jsonrpc: "2.0",
        id,
        result: {
          protocolVersion: "2024-11-05",
          capabilities: { tools: {} },
          serverInfo: { name: SERVER_NAME, version: "1.0.0" },
        },
      };

    case "tools/list":
      return {
        jsonrpc: "2.0",
        id,
        result: {
          tools: TOOLS.map((t) => ({
            name: t.name,
            description: t.description,
            inputSchema: t.inputSchema,
          })),
        },
      };

    case "tools/call": {
      const name = params && params.name;
      const tool = TOOLS.find((t) => t.name === name);
      if (!tool) {
        return {
          jsonrpc: "2.0",
          id,
          error: { code: -32602, message: "Unknown tool: " + name },
        };
      }
      const args = (params && params.arguments) || {};
      try {
        const result = await callBackend(name, args);
        return {
          jsonrpc: "2.0",
          id,
          result: {
            content: [
              { type: "text", text: JSON.stringify(result, null, 2) },
            ],
          },
        };
      } catch (e) {
        const message = e && e.message ? e.message : String(e);
        return {
          jsonrpc: "2.0",
          id,
          result: {
            content: [
              { type: "text", text: "Error calling " + name + ": " + message },
            ],
            isError: true,
          },
        };
      }
    }

    case "notifications/initialized":
    case "notifications/cancelled":
      return null;

    default:
      return {
        jsonrpc: "2.0",
        id,
        error: { code: -32601, message: "Method not found: " + method },
      };
  }
}

export default {
  async fetch(request) {
    if (request.method === "OPTIONS") {
      return new Response(null, { status: 204, headers: CORS });
    }
    if (request.method === "GET") {
      return json({
        server: SERVER_NAME,
        protocol: "Model Context Protocol",
        transport: "HTTP JSON-RPC 2.0",
        tools: TOOLS.length,
        api_base: API_BASE || null,
        hint: "POST a JSON-RPC 2.0 request to this URL.",
      });
    }
    if (request.method !== "POST") {
      return json({ error: "Method not allowed" }, 405);
    }
    let body;
    try {
      body = await request.json();
    } catch {
      return json(
        {
          jsonrpc: "2.0",
          id: null,
          error: { code: -32700, message: "Parse error" },
        },
        400,
      );
    }
    if (Array.isArray(body)) {
      const responses = [];
      for (const r of body) {
        const out = await handleRpc(r);
        if (out !== null) responses.push(out);
      }
      return json(responses);
    }
    const response = await handleRpc(body);
    if (response === null) {
      return new Response(null, { status: 202, headers: CORS });
    }
    return json(response);
  },
};
